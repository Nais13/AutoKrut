from django.shortcuts import render, redirect, get_object_or_404
from django.contrib import messages
from django.db.models import Q
from django.http import JsonResponse
from django.contrib.auth.hashers import make_password, check_password
import datetime

from .models import (
    Brand, CarModel, Car, CarListing, CarPhoto,
    Favorite, UserProfile, ListingStatus, Seller,
    Color, FuelType, Gearbox,
)
from .forms import CarListingForm


# ---------- helpers ----------
def get_current_user(request):
    """Пользователь из сессии."""
    user_id = request.session.get("user_id")
    if user_id:
        return UserProfile.objects.filter(id=user_id).first()
    return None


# ---------- auth ----------
def login_view(request):
    if request.method == "POST":
        email = request.POST.get("email", "").strip()
        password = request.POST.get("password", "")

        user = UserProfile.objects.filter(email=email).first()

        # ОТЛАДКА (временно)
        if not user:
            messages.error(request, f"Пользователь с email '{email}' не найден!")
            return render(request, "login.html")

        is_correct = check_password(password, user.password)

        if is_correct:
            request.session["user_id"] = user.id
            messages.success(request, "Успех!")
            return redirect("index")
        else:
            # ОТЛАДКА (временно)
            messages.error(request, f"Пароль неверный. Введено: '{password}', в базе: '{user.password[:20]}...'")

    return render(request, "login.html")


def register_view(request):
    if request.method == "POST":
        full_name = request.POST.get("full_name", "").strip()
        email = request.POST.get("email", "").strip()
        phone = request.POST.get("phone", "").strip()
        password = request.POST.get("password", "")
        password2 = request.POST.get("password2", "")
        is_seller = request.POST.get("is_seller") == "on"  # Галочка "Я продавец"

        if password != password2:
            messages.error(request, "Пароли не совпадают")
        elif UserProfile.objects.filter(email=email).exists():
            messages.error(request, "Пользователь с таким email уже существует")
        elif not email or not password:
            messages.error(request, "Заполните email и пароль")
        else:
            last = UserProfile.objects.order_by("-id").first()
            new_id = (last.id + 1) if last else 1

            user = UserProfile.objects.create(
                id=new_id,
                full_name=full_name,
                email=email,
                phone=phone,
                password=make_password(password),
                registration_date=datetime.date.today(),
            )

            # Если выбрана роль "Продавец" – создаем профиль продавца
            if is_seller:
                Seller.objects.create(
                    user=user,
                    registration_date=datetime.date.today()
                )
                messages.success(request, "Вы успешно зарегистрированы как Продавец! Теперь войдите в аккаунт.")
            else:
                messages.success(request, "Регистрация успешна! Войдите в аккаунт.")

            return redirect("login")
    return render(request, "register.html")


def logout_view(request):
    request.session.flush()
    messages.info(request, "Вы вышли из аккаунта")
    return redirect("index")


# ---------- главная ----------
def index(request):
    qs = CarListing.objects.select_related(
        "car__model__brand", "car__color", "car__fuel_type", "car__gearbox",
        "seller__user", "status",
    )

    active = qs.filter(status__name__icontains="активн").order_by("-publication_date")
    listings = active if active.exists() else qs.order_by("-publication_date")

    brand_id = request.GET.get("brand")
    model_id = request.GET.get("model")
    query = request.GET.get("q")

    if brand_id:
        listings = listings.filter(car__model__brand_id=brand_id)
    if model_id:
        listings = listings.filter(car__model_id=model_id)
    if query:
        listings = listings.filter(
            Q(car__model__brand__name__icontains=query)
            | Q(car__model__name__icontains=query)
            | Q(car__description__icontains=query)
        )

    user = get_current_user(request)
    favorite_ids = []
    if user:
        favorite_ids = list(
            Favorite.objects.filter(user=user).values_list("listing_id", flat=True)
        )

    return render(request, "index.html", {
        "listings": listings,
        "brands": Brand.objects.all().order_by("name"),
        "models": CarModel.objects.all().order_by("name"),
        "selected_brand": brand_id,
        "selected_model": model_id,
        "query": query or "",
        "favorite_ids": favorite_ids,
        "user": user,
    })


# ---------- детальная ----------
def listing_detail(request, pk):
    listing = get_object_or_404(
        CarListing.objects.select_related(
            "car__model__brand", "car__color", "car__fuel_type", "car__gearbox",
            "seller__user", "status",
        ),
        pk=pk,
