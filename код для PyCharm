# ---------- AJAX ----------
def load_models(request):
    brand_id = request.GET.get("brand_id")
    models = CarModel.objects.filter(brand_id=brand_id).order_by("name") if brand_id else CarModel.objects.none()
    return JsonResponse({"models": [{"id": m.id, "name": m.name} for m in models]})


# ---------- добавление ----------
def add_listing(request):
    user = get_current_user(request)
    if not user:
        messages.warning(request, "Войдите, чтобы добавлять объявления")
        return redirect("login")

    # ПРОВЕРКА: Является ли пользователь продавцом?
    seller = Seller.objects.filter(user=user).first()
    if not seller:
        messages.error(request, "Только продавцы могут добавлять объявления.")
        return redirect("index")

    if request.method == "POST":
        form = CarListingForm(request.POST, request.FILES)
        if form.is_valid():
            car = Car.objects.create(
                model=form.cleaned_data["model"],
                year=form.cleaned_data["year"],
                mileage=form.cleaned_data["mileage"],
                color=form.cleaned_data["color"],
                fuel_type=form.cleaned_data["fuel_type"],
                gearbox=form.cleaned_data["gearbox"],
                description=form.cleaned_data["description"],
            )

            status = ListingStatus.objects.filter(name__icontains="активн").first() \
                     or ListingStatus.objects.first()

            listing = CarListing.objects.create(
                seller=seller,
                car=car,
                price=form.cleaned_data["price"],
                publication_date=datetime.date.today(),
                status=status,
            )

            for i, img in enumerate(request.FILES.getlist("photos")):
                CarPhoto.objects.create(car=car, url=img, is_main=(i == 0))

            messages.success(request, "Объявление успешно добавлено!")
            return redirect("listing_detail", pk=listing.pk)
    else:
        form = CarListingForm()

    return render(request, "add_listing.html", {"form": form, "user": user})


# ---------- избранное ----------
def toggle_favorite(request, pk):
    user = get_current_user(request)
    if not user:
        messages.warning(request, "Войдите, чтобы добавлять в избранное")
        return redirect("login")

    listing = get_object_or_404(CarListing, pk=pk)
    fav, created = Favorite.objects.get_or_create(
        user=user,
        listing=listing,
        defaults={"added_date": datetime.date.today()},
    )
    if created:
        messages.success(request, "Добавлено в избранное")
    else:
        fav.delete()
        messages.info(request, "Удалено из избранного")

    return redirect(request.META.get("HTTP_REFERER") or "index")


def favorites(request):
    user = get_current_user(request)
    if not user:
        messages.warning(request, "Войдите, чтобы посмотреть избранное")
        return redirect("login")

    favs = Favorite.objects.filter(user=user).select_related(
        "listing__car__model__brand", "listing__car__color",
    )
    return render(request, "favorites.html", {"favorites": favs, "user": user})


