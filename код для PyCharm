    # Проверяем, есть ли у пользователя профиль продавца
    is_seller = Seller.objects.filter(user=user).exists()

    my_listings = CarListing.objects.filter(seller__user=user).select_related(
        "car__model__brand",
    )
    return render(request, "profile.html", {
        "user": user,
        "my_listings": my_listings,
        "is_seller": is_seller,  # Передаем в шаблон
    })

